/* Security Headers for Netlify/Cloudflare Pages */
/* ─── Global Headers ─── */
/* Ensure all requests are served over HTTPS */
/* Prevent browser from MIME-sniffing away from the declared content-type */
/* Prevent site from being embedded in a frame to prevent Clickjacking */
/* Control which information is sent in the Referer header */
/* Specify which browser features can be used */

/* All assets */
/* Max caching for static assets */
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/* All paths */
/* Security Headers */
/* Note: CSP is handled in index.html via meta tag for maximum deployment compatibility, 
   but ideally it should be here too if the host supports it well. */
/* Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.credly.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.emailjs.com; frame-src 'self' https://www.credly.com; base-uri 'self'; form-action 'self'; */

/* Headers */
/* Note: Removing Content-Security-Policy from here to avoid duplication if host automatically merges */
/* But strictly speaking, it's fine. Let's keep the others. */
/* Netlify style: */

/* Global */
/* Not using * because some hosts might be picky with order */

/
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
